# ==============================================================================
# Codificators LMS - Environment Configuration Template
# Copy to .env or .env.production and configure accordingly.
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
# In 'production', direct host subprocess execution is strictly blocked.
NODE_ENV=development

# Code Execution Backend:
# - 'docker': Enforces containerized execution (mandatory for production)
# - 'subprocess': Permitted ONLY in development mode with security boundary warning
# - 'disabled': Disables execution with HTTP 503 while keeping all LMS features active
EXECUTION_BACKEND=subprocess

# Docker Sandbox Container Image (when EXECUTION_BACKEND=docker)
SANDBOX_IMAGE=codificators-sandbox:latest

# Execution Concurrency & Queue Limits
EXECUTION_MAX_CONCURRENCY=4
EXECUTION_QUEUE_CAPACITY=50
EXECUTION_TIMEOUT_MS=2500

# SQLite Database Path (Optional, defaults to server/db/lms.db)
# LMS_DB_PATH=./server/db/lms.db

# Razorpay Standard Checkout Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Vite Public Key (Exposed to browser, Key ID only)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ==============================================================================
# Firebase Client SDK Configuration (Frontend Authentication & Cloud Storage)
# Obtain these from Firebase Console -> Project Settings -> General -> Web Apps
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ==============================================================================
# Firebase Admin SDK Configuration (Backend ID Token Verification & Cloud Storage)
# Option A: Service account JSON credentials via individual environment variables
# ==============================================================================
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Option B (Alternative): Absolute or relative path to service-account.json
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./server/config/service-account.json


